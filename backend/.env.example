APP_ENV=development
APP_NAME=FrameForge AI Video Backend
APP_VERSION=1.0.0
DATABASE_URL=sqlite:///./frameforge.db

FRONTEND_ORIGINS=http://localhost:3000,https://frameforge-ai-video-three.vercel.app

# Use 'demo' for free-first local/FFmpeg rendering, or 'ai' when a real provider is configured
GENERATION_MODE=demo

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage/videos
TEMP_STORAGE_PATH=storage/tmp

MAX_CONCURRENT_JOBS=1
MAX_PROMPT_LENGTH=2000
JOB_TIMEOUT_SECONDS=900
JOB_MAX_RETRIES=1
RATE_LIMIT_REQUESTS_PER_MINUTE=10

AI_PROVIDER=none
AI_API_KEY=
TTS_PROVIDER=none
